# Target and flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (8 MB octal) and clocks
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000

# Bigger main task: board bring-up runs there
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi buffers in PSRAM where possible
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_LOG=n

# ---- Internal RAM budget -------------------------------------------------
# The ESP32-S3 has ~340 kB of internal RAM shared by Wi-Fi, TLS, LVGL and
# audio. Keep as much as possible dynamic and in PSRAM.

# LVGL objects through malloc() (falls back to PSRAM) instead of a 64 kB static pool
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Smaller LVGL draw strip (368 x 60 x 2 bytes = 44 kB); the panel is updated in strips
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=60

# Medium and large allocations go to PSRAM; Wi-Fi and lwIP buffers may too
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Wi-Fi code in flash rather than IRAM: we need tens of kB/s, not maximum throughput
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8

# TLS (for wss:// servers) buffers allocated on demand and in PSRAM
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
