# Copy to .env and fill in. Every value can also be set as an environment variable.

# Claude auth for the chat and notes apps: either sign in once with the
# Anthropic CLI (`ant auth login`; the SDK picks up the profile) or set a key
# here. Leave the key line out when using the profile: an empty value still
# overrides it.
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model and effort levels.
CLAUDE_MODEL=claude-opus-5-5
CHAT_EFFORT=low
NOTES_EFFORT=medium

# Speech-to-text: openai | local | none
STT_PROVIDER=openai
# Text-to-speech: openai | piper | none
TTS_PROVIDER=openai

# Used when a provider is "openai".
OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Used when STT_PROVIDER=local (faster-whisper model size: tiny, base, small, medium)
# and the device it runs on (cpu, or cuda with the CUDA runtime installed).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Used when TTS_PROVIDER=piper: path to a .onnx voice, and the piper executable
# (defaults to "piper" on PATH).
PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
PIPER_BIN=piper

# Where meeting notes are written, and how many seconds of audio to transcribe at a time.
NOTES_DIR=./notes
NOTES_WINDOW_SECONDS=20

# Listen address.
HOST=0.0.0.0
PORT=8765
